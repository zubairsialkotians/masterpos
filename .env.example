# MasterPOS — one staff app for every shop (owner, branch admin, cashier, kitchen, rider)
EXPO_PUBLIC_APP_NAME=MasterPOS
EXPO_PUBLIC_API_BASE=https://sialkotians.com
# No shop key: the staff login picks the shop
EXPO_PUBLIC_PRIMARY_COLOR="#7fd38b"
EXPO_PUBLIC_ACCENT_COLOR="#1f7a45"

# Play Store: public URL of store/privacy-policy.html once hosted (shows in My account)
EXPO_PUBLIC_PRIVACY_URL=

# Native app identity (used by app.config.js)
APP_NAME=MasterPOS
APP_SLUG=masterpos
APP_BUNDLE_ID=com.sialkotians.masterpos

# Push notifications: EAS project id (npx eas init) and google-services.json for APP_BUNDLE_ID
EAS_PROJECT_ID=
GOOGLE_SERVICES_FILE=./google-services.json
